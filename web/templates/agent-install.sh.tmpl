#!/usr/bin/env bash
# Pemasang agent dbpanel, dibuat oleh panel {{.PanelURL}}.
# Jalankan di server database: curl -fsSL "<alamat ini>" | sudo bash
#
# Skrip ini mengunduh binary dbpanel dari panel (tanpa internet), menulis
# service systemd dbpanel-agent, memasangkan agent ke panel dengan token
# sekali pakai, lalu menyalakan service. Aman dijalankan ulang.
set -euo pipefail

BIN=/usr/local/bin/dbpanel

die() {
	echo "$*" >&2
	exit 1
}

main() {
	if [ "$(id -u)" -ne 0 ]; then
		die "Jalankan dengan sudo"
	fi

	local machine arch
	machine=$(uname -m)
	case "$machine" in
	x86_64) arch=amd64 ;;
	aarch64) arch=arm64 ;;
	*) die "arsitektur tidak didukung: $machine" ;;
	esac

	echo "Mengunduh dbpanel ($arch) dari panel..."
	trap 'rm -f "$BIN.new"' EXIT
	# No curl -f: on an error the body is the panel's own message (e.g. no
	# binary for this arch), which -f would discard. --fail-with-body needs
	# curl 7.76, newer than RHEL 8 and Ubuntu 20.04 ship.
	local code
	if ! code=$(curl -sSL -o "$BIN.new" -w '%{http_code}' "{{.PanelURL}}/agent/bin/${arch}?token={{.Token}}"); then
		die "Gagal menghubungi panel {{.PanelURL}}. Periksa alamat panel dan jaringan, lalu ulangi."
	fi
	if [ "$code" != 200 ]; then
		die "Panel menolak unduhan binary (HTTP $code): $(head -c 512 "$BIN.new")"
	fi
	# A proxy or captive portal can answer 200 with an HTML page. od, not
	# cmp: minimal RHEL images lack diffutils.
	if [ "$(head -c 4 "$BIN.new" | od -An -tx1 | tr -d ' \n')" != 7f454c46 ]; then
		die "Unduhan bukan binary yang valid (mungkin proxy/portal jaringan). Periksa koneksi ke panel."
	fi
	chmod 0755 "$BIN.new"
	mv -f "$BIN.new" "$BIN"

	cat >/etc/systemd/system/dbpanel-agent.service <<'UNIT'
[Unit]
Description=dbpanel agent
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/dbpanel agent
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
UNIT

	echo "Memasangkan agent ke panel..."
	if ! "$BIN" agent pair --panel "{{.PanelURL}}" --token "{{.Token}}"; then
		die "Pairing gagal. Periksa token dan alamat panel, lalu ulangi."
	fi

	# A running agent keeps the old binary and certificate until restarted.
	local was_active=0
	if systemctl is-active --quiet dbpanel-agent; then
		was_active=1
	fi
	# Separate statements: set -e would ignore a failure early in an && list.
	systemctl daemon-reload || die "Gagal memuat ulang systemd (systemctl daemon-reload)."
	systemctl enable --now dbpanel-agent || die "Gagal menyalakan service dbpanel-agent. Periksa: journalctl -u dbpanel-agent"
	if [ "$was_active" -eq 1 ]; then
		systemctl restart dbpanel-agent || die "Gagal memulai ulang service dbpanel-agent. Periksa: journalctl -u dbpanel-agent"
	fi

	# Give a crashing agent time to exit (or sit in auto-restart) first; must
	# exceed RestartSec=3.
	sleep 5
	if ! systemctl is-active --quiet dbpanel-agent; then
		die "Agent terpasang tetapi service tidak berjalan. Periksa: journalctl -u dbpanel-agent"
	fi
	echo "Agent terpasang dan terhubung ke panel"
	echo "Bila server tetap offline di panel, pastikan server ini dapat menjangkau {{.AgentAddr}}."
}

# Everything runs from main so a download cut short never runs half a script.
main "$@"
