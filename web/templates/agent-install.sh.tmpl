#!/usr/bin/env bash
# Pemasang agent dbpanel, dibuat oleh panel di PANEL_URL (lihat di bawah).
# Perintah pairing di panel mengunduh skrip ini ke berkas sementara baru
# (mktemp), mencocokkan sha256-nya dengan yang ditampilkan panel, baru
# menjalankannya dengan sudo. Tidak ada unduhan yang mengikuti pengalihan
# (redirect): token tidak boleh ikut terkirim ke host lain.
#
# Skrip ini mengunduh binary dbpanel dari panel (tanpa internet) dan
# mencocokkan sha256-nya, menulis service systemd dbpanel-agent, memasangkan
# agent ke panel dengan token sekali pakai (agent hanya menerima CA panel
# dengan sidik jari CA_SHA256), lalu menyalakan service. Aman dijalankan
# ulang.
set -euo pipefail

BIN=/usr/local/bin/dbpanel
# Nilai dari panel, dalam kutip tunggal: shell tidak mengekspansi isinya.
PANEL_URL={{shq .PanelURL}}
AGENT_ADDR={{shq .AgentAddr}}
# sha256 sertifikat CA panel (DER). Panel lain, mis. penyusup di jaringan
# yang menjawab pairing, ditolak oleh "dbpanel agent pair".
CA_SHA256={{shq .CASHA256}}
# sha256 binary agent yang disajikan panel per arsitektur (kosong: panel
# tidak punya binary untuk arsitektur itu).
BIN_SHA256_AMD64={{shq (index .BinSHA256 "amd64")}}
BIN_SHA256_ARM64={{shq (index .BinSHA256 "arm64")}}
# Token sekali pakai. Tidak pernah ditaruh di argumen perintah (argv bisa
# dibaca semua pengguna lewat ps): curl menerimanya lewat konfigurasi di
# stdin, dbpanel lewat variabel lingkungan DBPANEL_TOKEN.
TOKEN={{shq .Token}}

die() {
	echo "$*" >&2
	exit 1
}

# download_agent installs the panel's dbpanel binary for this machine at
# $BIN, after checking it against the hash the panel put in this script.
download_agent() {
	local machine arch want
	machine=$(uname -m)
	case "$machine" in
	x86_64) arch=amd64 want=$BIN_SHA256_AMD64 ;;
	aarch64) arch=arm64 want=$BIN_SHA256_ARM64 ;;
	*) die "arsitektur tidak didukung: $machine" ;;
	esac
	if [ -z "$want" ]; then
		die "binary untuk arsitektur ini belum tersedia di panel"
	fi

	echo "Mengunduh dbpanel ($arch) dari panel..."
	trap 'rm -f "$BIN.new"' EXIT
	# No curl -f: on an error the body is the panel's own message (e.g. no
	# binary for this arch), which -f would discard. --fail-with-body needs
	# curl 7.76, newer than RHEL 8 and Ubuntu 20.04 ship.
	local code
	# printf is a bash builtin, so the URL with the token is never in argv.
	# max-redirs = 0: a redirect would send the token to another host.
	if ! code=$(printf 'url = "%s"\nmax-redirs = 0\n' "$PANEL_URL/agent/bin/$arch?token=$TOKEN" |
		curl -sSL -o "$BIN.new" -w '%{http_code}' -K -); then
		die "Gagal menghubungi panel $PANEL_URL. Periksa alamat panel dan jaringan, lalu ulangi."
	fi
	if [ "$code" != 200 ]; then
		die "Panel menolak unduhan binary (HTTP $code): $(head -c 512 "$BIN.new")"
	fi
	# A proxy or captive portal can answer 200 with an HTML page. od, not
	# cmp: minimal RHEL images lack diffutils.
	if [ "$(head -c 4 "$BIN.new" | od -An -tx1 | tr -d ' \n')" != 7f454c46 ]; then
		die "Unduhan bukan binary yang valid (mungkin proxy/portal jaringan). Periksa koneksi ke panel."
	fi
	# The binary runs as root: it must be exactly the one the panel hashed.
	if ! echo "$want  $BIN.new" | sha256sum -c --status -; then
		die "Checksum binary agent tidak cocok; kemungkinan ada yang menyusup di jaringan"
	fi
	chmod 0755 "$BIN.new"
	mv -f "$BIN.new" "$BIN"
}

main() {
	if [ "$(id -u)" -ne 0 ]; then
		die "Jalankan dengan sudo"
	fi

	download_agent

	cat >/etc/systemd/system/dbpanel-agent.service <<'UNIT'
[Unit]
Description=dbpanel agent
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/dbpanel agent
Restart=always
RestartSec=3
# Root: the agent manages MySQL. No ProtectSystem: the agent writes
# /etc/dbpanel (sealed MySQL credentials), the MySQL option files under
# /etc and the data directory, and mysql.install installs packages into
# /usr. KillMode=process: a mysqld the agent started through an init
# script or mysqld_safe stays up when the agent restarts.
User=root
KillMode=process
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
UNIT

	echo "Memasangkan agent ke panel..."
	if ! DBPANEL_TOKEN="$TOKEN" "$BIN" agent pair --panel "$PANEL_URL" --ca-sha256 "$CA_SHA256" --agent-addr "$AGENT_ADDR"; then
		die "Pairing gagal. Periksa token dan alamat panel, lalu ulangi."
	fi

	# A running agent keeps the old binary and certificate until restarted.
	local was_active=0
	if systemctl is-active --quiet dbpanel-agent; then
		was_active=1
	fi
	# Separate statements: set -e would ignore a failure early in an && list.
	systemctl daemon-reload || die "Gagal memuat ulang systemd (systemctl daemon-reload)."
	systemctl enable --now dbpanel-agent || die "Gagal menyalakan service dbpanel-agent. Periksa: journalctl -u dbpanel-agent"
	if [ "$was_active" -eq 1 ]; then
		systemctl restart dbpanel-agent || die "Gagal memulai ulang service dbpanel-agent. Periksa: journalctl -u dbpanel-agent"
	fi

	# Give a crashing agent time to exit (or sit in auto-restart) first; must
	# exceed RestartSec=3.
	sleep 5
	if ! systemctl is-active --quiet dbpanel-agent; then
		die "Agent terpasang tetapi service tidak berjalan. Periksa: journalctl -u dbpanel-agent"
	fi
	echo "Agent terpasang dan terhubung ke panel"
	echo "Bila server tetap offline di panel, pastikan server ini dapat menjangkau $AGENT_ADDR."
}

# Everything runs from main so a download cut short never runs half a script.
main "$@"
